# AgroScan AI Backend Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO GIT

APP_NAME="AgroScan AI"
APP_ENV="development"
DEBUG=true
PORT=8000
DEMO_MODE=false

# Database Configuration (SQLite default for local, PostgreSQL for production)
DATABASE_URL="sqlite:///./agroscan.db"

# JWT Security Key (Generate using `openssl rand -hex 32`)
SECRET_KEY="your_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Allowed Origins
FRONTEND_URL="http://localhost:5173,https://agro-scan-ai-nine.vercel.app"
MAX_UPLOAD_SIZE_MB=10

# External AI & Botanical API Keys
PLANT_ID_API_KEY="your_plant_id_api_key"
PERENUAL_API_KEY="your_perenual_api_key"
WEATHER_API_KEY="your_open_weather_map_api_key"
GEMINI_API_KEY="your_gemini_api_key"

# Machine Learning Engine Configuration
MODEL_TYPE="huggingface"
DEFAULT_LOCAL_MODEL="neghani/plantvillage-mobilenetv2"
LOCAL_MODEL_PATH="backend/models/plantvillage-mobilenetv2"
LOCAL_INFERENCE_ENABLED=true
HF_INFERENCE_TIMEOUT=8.0

# Temperature Scaling Calibration & Uncertainty Thresholds
# Derived from neghani/plantvillage-mobilenetv2 calibration.json and threshold.json
CONFIDENCE_CALIBRATION_TEMPERATURE=0.8845188130635788
HIGH_CONFIDENCE_THRESHOLD=0.70
MODERATE_CONFIDENCE_THRESHOLD=0.50
UPLOAD_DIR="./uploads"
